# --- LLM / Ollama ---
OLLAMA_BASE_URL_PRIMARY=
OLLAMA_BASE_URL_FALLBACK=http://localhost:11434
OLLAMA_HEALTHCHECK_TIMEOUT_MS=2000
OLLAMA_MODEL_DEFAULT=qwen2.5:3b-instruct-q4_K_M
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=5m
EMBEDDING_MODEL=bge-m3

# --- Database ---
DATABASE_URL=sqlite:///./vat_copilot.db

# --- Auth ---
AUTH_SESSION_EXPIRY_HOURS=8

# --- Risk thresholds (Agent 6) ---
RISK_THRESHOLD_OFFICER=0.6
RISK_THRESHOLD_SENIOR=0.35

# --- Multi-turn (Agent 3) ---
CONVERSATION_MAX_TURNS=5
RETRIEVAL_TOP_K=5
RETRIEVAL_TOP_K_IN_PROMPT=3
CHUNK_MAX_TOKENS=350

# --- Dev workflow ---
USE_MOCK_LLM=true
CHROMA_PERSIST_DIR=./chroma_data
