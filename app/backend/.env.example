# --- LLM / Ollama ---
OLLAMA_BASE_URL_PRIMARY=
OLLAMA_BASE_URL_FALLBACK=http://localhost:11434
OLLAMA_HEALTHCHECK_TIMEOUT_MS=2000
OLLAMA_MODEL_DEFAULT=qwen2.5:3b-instruct
# 3 ค่าต่อไปนี้เป็นของ Ollama server — ตั้งเป็นตัวแปรระบบ Windows แล้วเปิด Ollama ใหม่ (แอปนี้ไม่ได้อ่าน)
# MAX_LOADED_MODELS=2 ให้ qwen กับ nomic อยู่ใน RAM พร้อมกัน (ตั้ง 1 ต้องโหลด qwen ใหม่ทุกคำถาม เสีย 3–4 วินาที)
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=30m
# เธรดที่ส่งให้ Ollama ต่อคำขอ — 0 = ให้ Ollama เลือกเอง; ห้ามเกินจำนวนคอร์จริง
# วัดบน i5-8250U (4C/8T): 4 เธรด prompt 32.3 tok/s, 6 เธรด 25.9, 8 เธรด 30.7 — ใช้ 4 (เท่าคอร์จริง)
OLLAMA_NUM_THREAD=4
EMBEDDING_MODEL=nomic-embed-text

# --- Database ---
# ไม่ตั้ง = app/backend/vat_copilot.db  (ถ้าตั้งเอง ใช้ path เต็ม เช่น sqlite:///C:/vat/vat_copilot.db)
# DATABASE_URL=

# --- Auth ---
AUTH_SESSION_EXPIRY_HOURS=8
# สลับบทบาทโดยไม่ใส่รหัส — ใช้เฉพาะงานสาธิต ห้ามเปิดบนเครื่องใช้งานจริง
ENABLE_DEMO_ROLE_SWITCH=false
# origin ของหน้าเว็บที่เรียก API ได้ (คั่นด้วยจุลภาค)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Risk thresholds (Agent 6) ---
RISK_THRESHOLD_OFFICER=0.6
RISK_THRESHOLD_SENIOR=0.35

# --- Multi-turn (Agent 3) ---
CONVERSATION_MAX_TURNS=5
RETRIEVAL_TOP_K=5
RETRIEVAL_TOP_K_IN_PROMPT=3
CHUNK_MAX_TOKENS=350

# --- Dev workflow ---
# true = ตอบด้วยข้อความจำลอง ไม่เรียก qwen (การค้นตัวบทยังเรียก Ollama embedding เสมอ)
USE_MOCK_LLM=false
CHROMA_PERSIST_DIR=./chroma_data
